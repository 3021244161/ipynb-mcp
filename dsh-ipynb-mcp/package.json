{
  "name": "dsh-ipynb-mcp",
  "version": "0.1.0",
  "description": "dsh bundle: connect the ipynb-mcp stdio server (read/edit/run local Jupyter notebooks) to dsh.",
  "license": "MIT",
  "type": "module",
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.2 <0.3.0"
  },
  "files": [
    "dsh.bundle.patch",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": "dsh.bundle.patch"
  }
}
